{
	"include": [
		"~/.config/waybar/modules/hypr/window.jsonc",
		"~/.config/waybar/modules/hypr/workspaces.jsonc",
		"~/.config/waybar/modules/custom/arch.jsonc",
		"~/.config/waybar/modules/custom/browser.jsonc",
		"~/.config/waybar/modules/custom/fileman.jsonc",
		"~/.config/waybar/modules/custom/terminal.jsonc",
		"~/.config/waybar/modules/custom/virtmanager.jsonc",
		"~/.config/waybar/modules/custom/nvim.jsonc",
		"~/.config/waybar/modules/custom/nowplaying.jsonc",
		"~/.config/waybar/modules/custom/updates.jsonc",
		"~/.config/waybar/modules/custom/launcher.jsonc",
		"~/.config/waybar/modules/custom/spacers.jsonc",
		"~/.config/waybar/modules/custom/system.jsonc",
		"~/.config/waybar/modules/bluetooth.jsonc",
		"~/.config/waybar/modules/custom/vpn.jsonc",
		"~/.config/waybar/modules/pulseaudio.jsonc",
		"~/.config/waybar/modules/backlight.jsonc",
		"~/.config/waybar/modules/battery.jsonc",
		"~/.config/waybar/modules/custom/clock.jsonc",
		"~/.config/waybar/modules/custom/voxtype.jsonc",
		"~/.config/waybar/modules/custom/screenrecording.jsonc",
		"~/.config/waybar/modules/custom/idle.jsonc",
		"~/.config/waybar/modules/custom/notifications.jsonc",
		"~/.config/waybar/modules/network.jsonc",
		"~/.config/waybar/modules/tray.jsonc"
	],
	"position": "bottom",
	"height": 28,
	"modules-left": [
    // "custom/arch",
		// "custom/system",
		// "custom/launcher",
		// "custom/browser",
		// "custom/fileman",
		// "custom/terminal",
		// "custom/virtmanager",
    "hyprland/workspaces",
    "hyprland/window"
	],
	"modules-center": [
		"custom/clock",
		"custom/voxtype",
		"custom/screenrecording-indicator",
		"custom/idle-indicator",
		"custom/notification-silencing-indicator"
	],
	"modules-right": [
    "group/tray-expander",
    "custom/nowplaying",
    // "custom/updates",
		"custom/spacer",
		"pulseaudio",
		"custom/spacer",
		"bluetooth",
		// "custom/spacer",
		// "custom/vpn",
		"custom/spacer",
		"network",
		"custom/spacer",
		"battery"
	],
	"group/tray-expander": {
		"orientation": "inherit",
		"drawer": {
			"transition-duration": 500,
			"children-class": "tray-group-item"
		},
		"modules": ["custom/expand-icon", "tray"]
	},
	"custom/expand-icon": {
		"format": "",
		"tooltip": false
	}
}
