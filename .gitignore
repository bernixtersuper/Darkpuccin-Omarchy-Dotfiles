# Sensitive / private data
.config/Signal/
.config/mozilla/
.config/chromium/
.config/pulse/
.config/dconf/
.config/ibus/
.config/hyprland-preview-share-picker/

# Typora - uninstalled, config dropped from the repo entirely
.config/Typora/

# Keyring (system passwords)
.local/share/keyrings/

# App data / caches (not config)
.local/share/Steam/
.local/share/recently-used.xbel
.local/share/gvfs-metadata/
.local/share/Trash/
.local/share/vulkan/
.local/share/zoxide/
.local/share/flatpak/
.local/share/applications/
.local/share/nautilus/
.local/share/org.localsend.localsend_app/
.local/share/nvim/
.local/share/omarchy/
.local/share/sddm/
.local/share/mise/
.local/share/hyprland/
.local/share/icons/
.local/state/
.config/mise/
.config/omarchy/current/
.config/omarchy/themes/catppuccin-dark-og/
.config/fcitx5/conf/cached_layouts
.config/btop/themes/
.config/nvim/lua/plugins/theme.lua
.stow-local-ignore

# Zen browser: never track the live profile — it holds cookies, logins.db,
# key4.db, sqlite DBs and session state. The durable config files are tracked
# separately under zen/ at repo root (installed into the active profile by
# install.sh, since the profile dir name is random per machine).
.config/zen/

# ---------------------------------------------------------------------------
# Claude Code: config is tracked, CREDENTIALS ARE NOT.
# ---------------------------------------------------------------------------
# THIS REPO IS PUBLIC. .credentials.json holds a live OAuth access token and
# refresh token for the Claude account -- committing it hands over account
# access to anyone who reads the repo, and git history would keep it after
# deletion. Never remove these lines.
.claude/.credentials.json
.claude/**/.credentials.json
.claude.json
.claude.json.backup

# Claude runtime state / history -- not config, and history.jsonl contains
# verbatim prompts (frequently secrets, paths, personal data).
.claude/history.jsonl
.claude/projects/
.claude/sessions/
.claude/session-env/
.claude/shell-snapshots/
.claude/file-history/
.claude/paste-cache/
.claude/backups/
.claude/cache/
.claude/telemetry/
.claude/.last-cleanup
.claude/plugins/marketplaces/
.claude/plugins/repos/

# cliamp: runtime state, not config
.config/cliamp/cliamp.sock.pid
.config/cliamp/resume.json
.config/cliamp/history.toml

# Timestamped backups written by omarchy refresh / manual edits
.config/hypr/*.bak.*
.config/omarchy/**/*.bak.*
.config/fcitx5/*.bak.*

# mozc: learned state only -- segment/boundary/cform DBs, .history.db (a record
# of what was actually typed) and a machine-local .encrypt_key.db. No portable
# settings live here, so it stays out of a public repo.
.config/mozc/
