#!/bin/bash
# fzf-based emoji picker — selects emoji and copies to clipboard

EMOJI_LIST=$(python3 - <<'PYEOF'
import unicodedata

ranges = [
    (0x1F600, 0x1F64F),  # Emoticons
    (0x1F300, 0x1F5FF),  # Misc symbols & pictographs
    (0x1F680, 0x1F6FF),  # Transport & map
    (0x1F900, 0x1F9FF),  # Supplemental symbols & pictographs
    (0x1FA70, 0x1FAFF),  # Symbols & pictographs extended-A
    (0x2600,  0x26FF),   # Misc symbols
    (0x2700,  0x27BF),   # Dingbats
    (0x231A,  0x231B),
    (0x23E9,  0x23F3),
    (0x23F8,  0x23FA),
    (0x25AA,  0x25AB),
    (0x25B6,  0x25B6),
    (0x25C0,  0x25C0),
    (0x25FB,  0x25FE),
    (0x2614,  0x2615),
    (0x2648,  0x2653),
    (0x267F,  0x267F),
    (0x2693,  0x2693),
    (0x26A1,  0x26A1),
    (0x26AA,  0x26AB),
    (0x26BD,  0x26BE),
    (0x26C4,  0x26C5),
    (0x26CE,  0x26CE),
    (0x26D4,  0x26D4),
    (0x26EA,  0x26EA),
    (0x26F2,  0x26F3),
    (0x26F5,  0x26F5),
    (0x26FA,  0x26FA),
    (0x26FD,  0x26FD),
    (0x2702,  0x2702),
    (0x2705,  0x2705),
    (0x2708,  0x270D),
    (0x270F,  0x270F),
    (0x2712,  0x2712),
    (0x2714,  0x2714),
    (0x2716,  0x2716),
    (0x271D,  0x271D),
    (0x2721,  0x2721),
    (0x2728,  0x2728),
    (0x2733,  0x2734),
    (0x2744,  0x2744),
    (0x2747,  0x2747),
    (0x274C,  0x274C),
    (0x274E,  0x274E),
    (0x2753,  0x2755),
    (0x2757,  0x2757),
    (0x2763,  0x2764),
    (0x2795,  0x2797),
    (0x27A1,  0x27A1),
    (0x27B0,  0x27B0),
    (0x27BF,  0x27BF),
    (0x2934,  0x2935),
    (0x2B05,  0x2B07),
    (0x1B1B,  0x2B1C),
    (0x2B50,  0x2B50),
    (0x2B55,  0x2B55),
    (0x3030,  0x3030),
    (0x303D,  0x303D),
    (0x3297,  0x3297),
    (0x3299,  0x3299),
]

seen = set()
for start, end in ranges:
    for cp in range(start, end + 1):
        if cp in seen:
            continue
        seen.add(cp)
        c = chr(cp)
        try:
            name = unicodedata.name(c)
            print(f"{c}  {name.lower()}")
        except ValueError:
            pass
PYEOF
)

selected=$(printf '%s\n' "$EMOJI_LIST" | fzf \
    --prompt='  emoji> ' \
    --no-preview \
    --layout=reverse \
    --border=rounded \
    --height=100%)

[[ -z "$selected" ]] && exit 0

emoji=$(echo "$selected" | awk '{print $1}')
printf '%s' "$emoji" | wl-copy
notify-send -t 1500 "Emoji copied" "$emoji"
